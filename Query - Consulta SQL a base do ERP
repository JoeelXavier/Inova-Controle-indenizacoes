SELECT  
IBETIDZELE.CODCET AS 'Sold', 
IBETCET.NOMRAZSCLCET AS 'Razão Social',
IBETSBN.CODMTCEPGRPS  AS 'SV',
IBETSBN.CODMTCEPGSBN AS 'VD',
IBETIDZELE.DATCADIDZELE AS 'Data da Inclusão',
IBETIDZELE.CODIDZELE AS 'N° FI',
Sum(IBETITEIDZELE.VALTOTITEIDZELE) AS 'Valor', 
IBETIDZELE.DATENVSAP AS 'Data Envio SAP', 
IBETIDZELE.RTNNTLCODSAPIDZELE AS 'ZRR',
IBETIDZELE.RTNNTLDATPGTIDZELE AS 'Data Pagamento', 
IBETDOMSTUIDZELE.DSCSTUIDZELE AS 'Status',
IBETCDD.DESCDD AS 'Cidade',
IBETCADRDE.DESRDE AS REDE,

CASE

WHEN IBETSBN.CODMTCEPGRPS IN (10,20,80,900) THEN '100'
WHEN IBETSBN.CODMTCEPGRPS IN (30,40,50,60,70) THEN '200'
 
END GERENTE

FROM 
IBETCET IBETCET, 
IBETDOMSTUIDZELE IBETDOMSTUIDZELE,
IBETIDZELE IBETIDZELE, 
IBETITEIDZELE IBETITEIDZELE,
IBETEDRCET IBETEDRCET, 
IBETSBN IBETSBN,
IBETCDD IBETCDD,
IBETCADRDE IBETCADRDE

WHERE 
IBETCET.CODCET = IBETIDZELE.CODCET 
AND IBETDOMSTUIDZELE.CODSTUIDZELE = IBETIDZELE.CODSTUIDZELE 
AND IBETITEIDZELE.CODIDZELE = IBETIDZELE.CODIDZELE
AND IBETIDZELE.CODMTCEPG = IBETSBN.CODMTCEPGSBN 
AND IBETDOMSTUIDZELE.CODSTUIDZELE NOT IN (6)
AND IBETIDZELE.DATCADIDZELE > '2025-10-01' 
AND IBETEDRCET.CODCET = IBETCET.CODCET
AND IBETEDRCET.CODCDD = IBETCDD.CODCDD
AND IBETCADRDE.CODRDE = IBETCET.CODRDE
AND IBETCDD.CODUF_ = 'PB'

GROUP BY 
IBETIDZELE.DATCADIDZELE,
IBETIDZELE.CODCET, IBETCET.NOMRAZSCLCET, 
IBETSBN.CODMTCEPGRPS,
IBETSBN.CODMTCEPGSBN,
IBETIDZELE.CODIDZELE,  
IBETIDZELE.DATENVSAP, 
IBETIDZELE.RTNNTLCODSAPIDZELE, 
IBETIDZELE.RTNNTLNUMNF_IDZELE, 
IBETIDZELE.RTNNTLDATPGTIDZELE, 
IBETDOMSTUIDZELE.CODSTUIDZELE, 
IBETDOMSTUIDZELE.DSCAPLSTUIDZELE,
IBETDOMSTUIDZELE.DSCSTUIDZELE,
IBETCDD.DESCDD,
IBETCADRDE.DESRDE
 
ORDER BY IBETIDZELE.DATCADIDZELE
